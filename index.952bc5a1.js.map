"use strict";
var gallery = document.querySelector(".gallery__list");
var mainImage = document.getElementById("largeImg");
if (gallery) gallery.addEventListener("click", function(e) {
    var link = e.target.closest(".list-item__link");
    if (!link) return;
    if (!mainImage) return;
    e.preventDefault();
    mainImage.src = link.href;
});

